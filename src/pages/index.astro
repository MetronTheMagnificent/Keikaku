---
import Layout from '../layouts/Layout.astro';
import { businesses, categories, getCategoryColor } from '../data/businesses';
const active = businesses.filter(b => b.active);
---
<Layout title="Directorio de Negocios en Nuevo León"
  description="Encuentra los mejores negocios en Monterrey y Nuevo León. Restaurantes, talleres, clínicas, gimnasios y más. Contacta directo y sin intermediarios."
  canonical="https://keikaku.mx">

  <!-- NAV -->
  <header class="sticky top-0 z-50 bg-white border-b border-slate-100 shadow-sm">
    <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <span class="text-xl font-bold text-indigo-600" style="font-family:'Space Grotesk',sans-serif;">Keikaku</span>
        <span class="hidden sm:inline text-xs text-slate-400 font-medium border border-slate-200 rounded-full px-2 py-0.5">Directorio NL</span>
      </a>
      <div class="flex items-center gap-3">
        <a href="mailto:keikakuconsulting@gmail.com"
          class="text-sm text-slate-500 hover:text-indigo-600 transition-colors hidden md:block font-medium">
          ¿Tienes un negocio? →
        </a>
        <a href="https://wa.me/528123705584?text=Hola%2C%20quiero%20publicar%20mi%20negocio%20en%20Keikaku"
          target="_blank" rel="noopener"
          class="btn-primary text-sm py-2 px-4">
          Publicar mi negocio
        </a>
      </div>
    </nav>
  </header>

  <!-- HERO -->
  <section class="bg-white border-b border-slate-100 px-4 py-14 text-center">
    <div class="max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full mb-5">
        📍 Nuevo León, México
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4 leading-tight"
          style="font-family:'Space Grotesk',sans-serif;">
        Encuentra negocios en<br class="hidden md:block"/> Nuevo León
      </h1>
      <p class="text-slate-500 text-lg mb-8 max-w-xl mx-auto">
        Restaurantes, talleres, clínicas, gimnasios y más. Contacta directo con el negocio.
      </p>

      <!-- Search -->
      <div class="relative max-w-xl mx-auto mb-6">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
        <input id="search" type="text" placeholder="Buscar negocio o categoría…"
          class="w-full pl-12 pr-4 py-3.5 rounded-xl border border-slate-200 shadow-sm text-sm focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-50 bg-white"
          autocomplete="off" />
      </div>

      <!-- Category pills -->
      <div class="flex flex-wrap justify-center gap-2" id="cat-filters">
        {categories.map(cat => (
          <button
            data-cat={cat}
            class={`cat-pill text-xs font-semibold px-4 py-1.5 rounded-full border transition-all duration-150 ${cat === 'Todos' ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-500 border-slate-200 hover:border-indigo-400 hover:text-indigo-600'}`}>
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- BUSINESS GRID -->
  <main class="max-w-6xl mx-auto px-4 py-12">
    <p class="text-sm text-slate-400 mb-6" id="results-count">{active.length} negocios encontrados</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="business-grid">
      {active.map(b => {
        const color = getCategoryColor(b.category);
        return (
          <a href={`/${b.slug}`} class="card group block cursor-pointer no-underline"
            data-name={b.name.toLowerCase()}
            data-cat={b.category}
            data-city={b.city.toLowerCase()}>

            <div class="flex items-start justify-between mb-3">
              <!-- Avatar placeholder -->
              <div class="w-12 h-12 rounded-xl flex items-center justify-center text-lg font-bold text-white flex-shrink-0"
                   style={`background:linear-gradient(135deg,#6366f1,#8b5cf6);`}>
                {b.name.charAt(0)}
              </div>
              <span class="badge" style={`background-color:${color.bg};color:${color.text};`}>
                {b.category}
              </span>
            </div>

            <h2 class="font-bold text-slate-900 text-base mb-1 group-hover:text-indigo-600 transition-colors"
                style="font-family:'Space Grotesk',sans-serif;">
              {b.name}
            </h2>
            <p class="text-xs text-slate-400 mb-3 flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              {b.city}, NL
            </p>
            <p class="text-sm text-slate-500 leading-relaxed line-clamp-2 mb-4">{b.tagline}</p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              {b.services.slice(0, 3).map(s => (
                <span class="text-xs bg-slate-50 text-slate-500 border border-slate-100 px-2 py-0.5 rounded-md">{s}</span>
              ))}
              {b.services.length > 3 && (
                <span class="text-xs text-slate-400 px-1 py-0.5">+{b.services.length - 3} más</span>
              )}
            </div>

            <div class="flex items-center justify-between text-xs text-slate-400 pt-3 border-t border-slate-50">
              <span>⏰ {b.hours.split('·')[0].trim()}</span>
              <span class="text-indigo-600 font-semibold group-hover:translate-x-0.5 transition-transform inline-block">Ver perfil →</span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-20 text-slate-400">
      <p class="text-4xl mb-3">🔍</p>
      <p class="font-medium text-slate-500">No encontramos negocios que coincidan.</p>
      <p class="text-sm mt-1">Prueba con otra búsqueda o categoría.</p>
    </div>
  </main>

  <!-- CTA BAND -->
  <section class="bg-indigo-600 py-16 px-4 text-center text-white">
    <h2 class="text-2xl md:text-3xl font-bold mb-3" style="font-family:'Space Grotesk',sans-serif;">
      ¿Tienes un negocio en NL?
    </h2>
    <p class="text-indigo-200 mb-6 text-sm max-w-md mx-auto">
      Publica tu perfil en Keikaku y recibe contactos directos de clientes en tu área. Paga solo por leads reales.
    </p>
    <a href="https://wa.me/528123705584?text=Hola%2C%20quiero%20publicar%20mi%20negocio%20en%20Keikaku"
      target="_blank" rel="noopener"
      class="inline-flex items-center gap-2 bg-white text-indigo-600 font-bold px-6 py-3 rounded-xl hover:bg-indigo-50 transition-colors">
      <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Publicar por WhatsApp
    </a>
  </section>

  <!-- FOOTER -->
  <footer class="bg-white border-t border-slate-100 text-center py-8 text-sm text-slate-400">
    <p class="font-semibold text-slate-600 mb-1" style="font-family:'Space Grotesk',sans-serif;">Keikaku — Directorio de Negocios NL</p>
    <p>Monterrey, Nuevo León, México · <a href="mailto:keikakuconsulting@gmail.com" class="hover:text-indigo-600 transition-colors">keikakuconsulting@gmail.com</a></p>
    <p class="mt-2 text-xs text-slate-300">© {new Date().getFullYear()} Keikaku. Todos los derechos reservados.</p>
  </footer>

  <script>
    const searchInput = document.getElementById('search') as HTMLInputElement;
    const grid = document.getElementById('business-grid');
    const cards = grid?.querySelectorAll<HTMLElement>('[data-name]') ?? [];
    const countEl = document.getElementById('results-count');
    const emptyState = document.getElementById('empty-state');
    const catPills = document.querySelectorAll<HTMLButtonElement>('.cat-pill');

    let activeCategory = 'Todos';
    let searchQuery = '';

    function updateGrid() {
      let visible = 0;
      cards.forEach(card => {
        const matchesCat = activeCategory === 'Todos' || card.dataset.cat === activeCategory;
        const q = searchQuery.toLowerCase();
        const matchesSearch = !q ||
          (card.dataset.name ?? '').includes(q) ||
          (card.dataset.cat ?? '').toLowerCase().includes(q) ||
          (card.dataset.city ?? '').includes(q);
        const show = matchesCat && matchesSearch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (countEl) countEl.textContent = `${visible} negocio${visible !== 1 ? 's' : ''} encontrado${visible !== 1 ? 's' : ''}`;
      emptyState?.classList.toggle('hidden', visible > 0);
    }

    catPills.forEach(pill => {
      pill.addEventListener('click', () => {
        activeCategory = pill.dataset.cat ?? 'Todos';
        catPills.forEach(p => {
          const isActive = p.dataset.cat === activeCategory;
          p.className = `cat-pill text-xs font-semibold px-4 py-1.5 rounded-full border transition-all duration-150 ${
            isActive ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-500 border-slate-200 hover:border-indigo-400 hover:text-indigo-600'
          }`;
        });
        updateGrid();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value;
      updateGrid();
    });
  </script>

</Layout>
