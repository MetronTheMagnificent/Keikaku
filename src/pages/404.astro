---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada">
  <div class="min-h-screen flex flex-col items-center justify-center text-center px-4">
    <p class="text-6xl font-bold text-slate-200 mb-4" style="font-family:'Space Grotesk',sans-serif;">404</p>
    <h1 class="text-xl font-bold text-slate-700 mb-2">Negocio no encontrado</h1>
    <p class="text-slate-400 text-sm mb-8">Esta página no existe o el negocio ya no está activo.</p>
    <a href="/" class="btn-primary">← Ver directorio</a>
  </div>
</Layout>
