---
import Layout from '../layouts/Layout.astro';
import { businesses, getCategoryColor } from '../data/businesses';

const { slug } = Astro.params;
const b = businesses.find(biz => biz.slug === slug);
if (!b) return Astro.redirect('/404');

const color = getCategoryColor(b.category);
const waMsg = encodeURIComponent(`Hola, vi su perfil en Keikaku y me interesa ${b.name}. ¿Podrían darme más información?`);
const canonical = `https://keikaku.mx/${b.slug}`;
---
<Layout
  title={b.name}
  description={`${b.tagline} — ${b.category} en ${b.city}, NL. ${b.services.slice(0,3).join(', ')} y más.`}
  canonical={canonical}>

  <!-- STICKY BUSINESS NAV -->
  <header class="sticky top-0 z-50 bg-white border-b border-slate-100 shadow-sm">
    <nav class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 text-slate-400 hover:text-indigo-600 transition-colors text-sm font-medium flex-shrink-0">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span class="hidden sm:inline">Keikaku</span>
      </a>
      <span class="font-bold text-slate-800 text-sm truncate flex-1 text-center" style="font-family:'Space Grotesk',sans-serif;">
        {b.name}
      </span>
      <a href={`https://wa.me/${b.whatsapp}?text=${waMsg}`} target="_blank" rel="noopener"
        id="cta-header"
        class="btn-wa text-xs py-2 px-3 flex-shrink-0">
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Contactar
      </a>
    </nav>
  </header>

  <!-- HERO -->
  <section style="background:linear-gradient(135deg,#1e1b4b 0%,#312e81 55%,#4338ca 100%);" class="px-4 py-16 text-white">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-center gap-8">
      <!-- Avatar -->
      <div class="w-20 h-20 rounded-2xl flex items-center justify-center text-3xl font-bold text-white flex-shrink-0 shadow-xl"
           style="background:rgba(255,255,255,0.15);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.2);">
        {b.name.charAt(0)}
      </div>

      <div class="flex-1">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="badge text-xs" style={`background-color:${color.bg};color:${color.text};`}>
            {b.category}
          </span>
          <span class="text-indigo-300 text-xs flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
            </svg>
            {b.city}, Nuevo León
          </span>
        </div>

        <h1 class="text-3xl md:text-4xl font-bold mb-2" style="font-family:'Space Grotesk',sans-serif;">{b.name}</h1>
        <p class="text-indigo-200 text-lg mb-4">{b.tagline}</p>

        <p class="text-indigo-300 text-sm flex items-center gap-1.5">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          {b.hours}
        </p>
      </div>

      <!-- CTA buttons hero -->
      <div class="flex flex-col gap-3 flex-shrink-0">
        <a href={`https://wa.me/${b.whatsapp}?text=${waMsg}`} target="_blank" rel="noopener"
          id="cta-wa-hero"
          class="btn-wa justify-center">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
        <a href={`tel:${b.phone}`} id="cta-phone-hero"
          class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white text-sm font-semibold px-5 py-3 rounded-xl transition-colors border border-white/20">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
          </svg>
          {b.phone}
        </a>
      </div>
    </div>
  </section>

  <main class="max-w-5xl mx-auto px-4 py-12 grid md:grid-cols-3 gap-8">

    <!-- LEFT: About + Services -->
    <div class="md:col-span-2 space-y-8">

      <!-- About -->
      <section class="card">
        <h2 class="section-title text-xl mb-4">Sobre nosotros</h2>
        <p class="text-slate-600 leading-relaxed">{b.description}</p>
      </section>

      <!-- Services -->
      <section class="card">
        <h2 class="section-title text-xl mb-4">Servicios</h2>
        <div class="flex flex-wrap gap-2">
          {b.services.map(s => (
            <span class="text-sm bg-indigo-50 text-indigo-700 border border-indigo-100 px-3 py-1.5 rounded-lg font-medium">
              {s}
            </span>
          ))}
        </div>
      </section>

      <!-- Contact form -->
      <section class="card" id="contact">
        <h2 class="section-title text-xl mb-1">Enviar mensaje</h2>
        <p class="text-slate-400 text-sm mb-5">Te responderán directamente. Sin intermediarios.</p>

        <form id="lead-form" class="space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1.5" for="nombre">Nombre *</label>
              <input id="nombre" name="nombre" type="text" required placeholder="Tu nombre" class="input-field" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1.5" for="telefono">Teléfono *</label>
              <input id="telefono" name="telefono" type="tel" required placeholder="81 xxxx xxxx" class="input-field" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5" for="email">Email (opcional)</label>
            <input id="email" name="email" type="email" placeholder="correo@ejemplo.com" class="input-field" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5" for="mensaje">Mensaje *</label>
            <textarea id="mensaje" name="mensaje" rows="3" required placeholder="¿En qué te pueden ayudar?" class="input-field resize-none"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full justify-center">
            Enviar mensaje
          </button>
          <div id="form-success" class="hidden text-center text-sm text-green-600 bg-green-50 border border-green-100 rounded-xl py-3">
            ✓ ¡Mensaje enviado! El negocio te contactará pronto.
          </div>
          <div id="form-error" class="hidden text-center text-sm text-red-500 bg-red-50 border border-red-100 rounded-xl py-3">
            Error al enviar. Contáctalos directamente por WhatsApp.
          </div>
        </form>
      </section>
    </div>

    <!-- RIGHT: Contact info + hours -->
    <aside class="space-y-5">

      <!-- Quick contact -->
      <div class="card">
        <h3 class="font-bold text-slate-800 text-sm mb-4" style="font-family:'Space Grotesk',sans-serif;">Contacto directo</h3>
        <div class="space-y-3">
          <a href={`https://wa.me/${b.whatsapp}?text=${waMsg}`} target="_blank" rel="noopener"
            id="cta-wa-aside"
            class="btn-wa w-full justify-center text-sm">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a href={`tel:${b.phone}`} id="cta-phone-aside"
            class="btn-ghost w-full justify-center text-sm">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
            </svg>
            {b.phone}
          </a>
          <a href={`mailto:${b.email}`} id="cta-email-aside"
            class="btn-ghost w-full justify-center text-sm overflow-hidden">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="truncate">{b.email}</span>
          </a>
        </div>
      </div>

      <!-- Hours -->
      <div class="card">
        <h3 class="font-bold text-slate-800 text-sm mb-3" style="font-family:'Space Grotesk',sans-serif;">Horario</h3>
        <p class="text-sm text-slate-600 leading-relaxed">{b.hours}</p>
      </div>

      <!-- Location -->
      <div class="card">
        <h3 class="font-bold text-slate-800 text-sm mb-3" style="font-family:'Space Grotesk',sans-serif;">Ubicación</h3>
        <p class="text-sm text-slate-600 flex items-start gap-2">
          <svg class="w-4 h-4 mt-0.5 text-indigo-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
          </svg>
          {b.city}, Nuevo León, México
        </p>
      </div>

      <!-- Keikaku badge -->
      <div class="text-center pt-2">
        <a href="/" class="text-xs text-slate-300 hover:text-indigo-400 transition-colors">
          Perfil publicado en <strong>Keikaku</strong> · Directorio NL
        </a>
      </div>
    </aside>
  </main>

  <!-- FOOTER -->
  <footer class="bg-white border-t border-slate-100 text-center py-6 text-xs text-slate-300">
    <a href="/" class="hover:text-indigo-500 transition-colors font-medium text-slate-400">← Ver todos los negocios en Keikaku</a>
    <p class="mt-1">© {new Date().getFullYear()} Keikaku — Directorio de Negocios NL</p>
  </footer>

</Layout>

<script define:vars={{ slug: b.slug, bizName: b.name, bizEmail: b.email, bizWhatsapp: b.whatsapp }}>
  // Track lead clicks
  async function trackLead(type) {
    await fetch('/api/lead', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug, bizName, bizEmail, bizWhatsapp, type }),
    }).catch(() => {});
  }

  ['cta-header','cta-wa-hero','cta-phone-hero','cta-wa-aside','cta-phone-aside','cta-email-aside'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', () => {
      const type = id.includes('wa') ? 'whatsapp' : id.includes('phone') ? 'phone' : 'email';
      trackLead(type);
    });
  });

  // Contact form
  const form = document.getElementById('lead-form');
  const submitBtn = form?.querySelector('button[type="submit"]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando…'; }
    const data = Object.fromEntries(new FormData(form));
    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, bizName, bizEmail, bizWhatsapp, type: 'form', ...data }),
      });
      if (!res.ok) throw new Error();
      form.reset();
      document.getElementById('form-success')?.classList.remove('hidden');
      document.getElementById('form-error')?.classList.add('hidden');
    } catch {
      document.getElementById('form-error')?.classList.remove('hidden');
      document.getElementById('form-success')?.classList.add('hidden');
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Enviar mensaje'; }
    }
  });
</script>
